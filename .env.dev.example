# ==============================================================================
# MoneyCraft 1.0.0 — Local Developer Non-Secret Environment Template (`.env.dev`)
# Zero secrets live here; local secrets reside in gitignored `.local-secrets/` (`0600`).
# ==============================================================================

MC_REGISTRY=local
MC_IMAGE_TAG=1.0.0-SNAPSHOT
MC_SPRING_PROFILE=dev
MC_ENV_LABEL=DEV
MC_RELEASE_VERSION=1.0.0-SNAPSHOT
MC_DEFAULT_CURRENCY=INR
MC_PUBLIC_API_URL=/api/v1

# Non-conflicting loopback host port bindings (`127.0.0.1` only)
MC_GATEWAY_HTTP_PORT=18080
MC_GATEWAY_HTTPS_PORT=18443
MC_BUSINESS_DB_PORT=55480
MC_AUTHORITY_DB_PORT=55481

MC_PUBLIC_HOSTNAME=localhost
MC_BASE_URL=https://localhost:18443
MC_WEBAUTHN_RP_ID=localhost
MC_WEBAUTHN_RP_NAME=MoneyCraft
MC_INSTALLATION_ID=00000000-0000-4000-8000-000000000000

MC_BUSINESS_DB_NAME=moneycraft_business
MC_BUSINESS_DB_SUPER_USER=mc_pg_super
MC_AUTHORITY_DB_NAME=moneycraft_authority
MC_AUTHORITY_DB_SUPER_USER=mc_auth_pg_super

# Path to gitignored 0700 directory containing 0600 secret files
MC_SECRETS_DIR=./.local-secrets
