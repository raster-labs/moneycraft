# ==============================================================================
# MoneyCraft 1.0.0 — Production Non-Secret Environment Template (`.env.prod`)
# Zero secrets live here; pin `<semver>@sha256:<digest>` tags and mount `0400`
# secrets from an external custody path (`MC_SECRETS_DIR`).
# ==============================================================================

MC_REGISTRY=ghcr.io/raster-images
MC_IMAGE_TAG=1.0.0
MC_SPRING_PROFILE=prod
MC_ENV_LABEL=PRODUCTION
MC_RELEASE_VERSION=1.0.0
MC_DEFAULT_CURRENCY=INR
MC_PUBLIC_API_URL=/api/v1
# Optional direct Backend API IP/Host and Port override for Angular UI runtime-config.json & Java Swing Desktop
MC_BACKEND_API_SCHEME=https
MC_BACKEND_API_HOST=erp.company.internal
MC_BACKEND_API_PORT=443

MC_PUBLIC_HOSTNAME=erp.company.internal
MC_BASE_URL=https://erp.company.internal
MC_WEBAUTHN_RP_ID=erp.company.internal
MC_WEBAUTHN_RP_NAME=MoneyCraft
MC_INSTALLATION_ID=<REPLACE_WITH_INSTALLATION_UUIDV4>

MC_BUSINESS_DB_NAME=moneycraft_business
MC_BUSINESS_DB_SUPER_USER=mc_pg_super
MC_AUTHORITY_DB_NAME=moneycraft_authority
MC_AUTHORITY_DB_SUPER_USER=mc_auth_pg_super

# External root-owned `0700` secret custody directory (`0400` files)
MC_SECRETS_DIR=/etc/moneycraft/prod/secrets
