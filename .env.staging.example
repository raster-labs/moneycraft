# ==============================================================================
# MoneyCraft 1.0.0 — Staging Non-Secret Environment Template (`.env.staging`)
# Zero secrets live here; mount protected `0400` secrets via `MC_SECRETS_DIR`.
# ==============================================================================

MC_REGISTRY=ghcr.io/raster-images
MC_IMAGE_TAG=1.0.0-rc.1
MC_SPRING_PROFILE=staging
MC_ENV_LABEL=STAGING
MC_RELEASE_VERSION=1.0.0-rc.1
MC_DEFAULT_CURRENCY=INR
MC_PUBLIC_API_URL=/api/v1

MC_STAGING_HTTPS_PORT=8443
MC_PUBLIC_HOSTNAME=staging.moneycraft.internal
MC_BASE_URL=https://staging.moneycraft.internal:8443
MC_WEBAUTHN_RP_ID=staging.moneycraft.internal
MC_WEBAUTHN_RP_NAME=MoneyCraft Staging
MC_INSTALLATION_ID=00000000-0000-4000-8000-000000000001

MC_BUSINESS_DB_NAME=moneycraft_business
MC_BUSINESS_DB_SUPER_USER=mc_pg_super
MC_AUTHORITY_DB_NAME=moneycraft_authority
MC_AUTHORITY_DB_SUPER_USER=mc_auth_pg_super

# External protected custody directory (`chmod 0700`, files `0400`)
MC_SECRETS_DIR=/etc/moneycraft/staging/secrets
