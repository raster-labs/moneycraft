<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apache Tomcat 11.0.x Hardened Server Configuration Snippet (`$CATALINA_BASE/conf/server.xml`)
  Disables shutdown TCP port, hides server version banner, enforces TLS 1.3,
  and configures `RemoteIpValve` for trusted LAN proxy topologies.
-->
<Server port="-1" shutdown="DISABLED">
    <Listener className="org.apache.catalina.startup.VersionLoggerListener"
              logArgs="false"
              logEnv="false"
              logProps="false" />
    <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" />

    <Service name="Catalina">
        <Executor name="moneycraftThreadPool"
                  namePrefix="mc-http-"
                  maxThreads="200"
                  minSpareThreads="25" />

        <Connector executor="moneycraftThreadPool"
                   port="8443"
                   protocol="org.apache.coyote.http11.Http11Nio2Protocol"
                   SSLEnabled="true"
                   scheme="https"
                   secure="true"
                   maxPostSize="67108864"
                   URIEncoding="UTF-8">
            <UpgradeProtocol className="org.apache.coyote.http2.Http2Protocol" />
            <SSLHostConfig protocols="TLSv1.3,+TLSv1.2"
                           honorCipherOrder="false">
                <Certificate certificateFile="/etc/moneycraft/tls/fullchain.pem"
                             certificateKeyFile="/etc/moneycraft/tls/privkey.pem"
                             type="EC" />
            </SSLHostConfig>
        </Connector>

        <Engine name="Catalina" defaultHost="localhost">
            <Host name="localhost"
                  appBase="webapps"
                  unpackWARs="true"
                  autoDeploy="false"
                  deployXML="true">

                <Valve className="org.apache.catalina.valves.RemoteIpValve"
                       internalProxies="127\.0\.0\.1"
                       remoteIpHeader="x-forwarded-for"
                       protocolHeader="x-forwarded-proto" />

                <Valve className="org.apache.catalina.valves.ErrorReportValve"
                       showReport="false"
                       showServerInfo="false" />
            </Host>
        </Engine>
    </Service>
</Server>
