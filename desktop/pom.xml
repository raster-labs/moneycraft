<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.raster.moneycraft</groupId>
        <artifactId>moneycraft-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>moneycraft-desktop</artifactId>
    <packaging>jar</packaging>
    <name>MoneyCraft Native Desktop &amp; Local Device Adapter Client</name>
    <description>
        Standalone Java 25 LTS Swing personal desktop client, RFC 8252 PKCE S256 external-browser sign-in,
        KEY-002 scoped InputMap/ActionMap profile, 3-level Gateway navigation, dual OS/raw-language print engine,
        7-state AES-GCM print uncertainty ledger, and weighing-scale / barcode capture adapters. Strictly zero JDBC,
        zero JPA, zero embedded DB, zero offline posting queue, and 100% excluded from server WARs.
    </description>

    <properties>
        <moneycraft.desktop.vendor>Raster Images</moneycraft.desktop.vendor>
        <moneycraft.desktop.app.version>1.0.0</moneycraft.desktop.app.version>
        <moneycraft.desktop.main.class>com.raster.moneycraft.desktop.MoneyCraftDesktopMain</moneycraft.desktop.main.class>
        <moneycraft.desktop.jlink.modules>java.base,java.desktop,java.net.http,jdk.httpserver,java.naming,java.security.jgss,jdk.crypto.ec</moneycraft.desktop.jlink.modules>
        <moneycraft.desktop.win.upgrade.uuid>8f4e3c2b-9a10-4d7c-b512-6e11a8f01100</moneycraft.desktop.win.upgrade.uuid>
    </properties>

    <!-- SWG-001 / AT09-SWG-001-C: Zero JDBC, zero PostgreSQL driver, zero Spring Data/JPA, zero embedded DB -->
    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>moneycraft-desktop</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>${moneycraft.desktop.main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-runtime-libs-for-standalone-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <excludes>META-INF/MANIFEST.MF,META-INF/*.SF,META-INF/*.DSA,META-INF/*.RSA,META-INF/LICENSE*,META-INF/NOTICE*,module-info.class,META-INF/versions/*/module-info.class</excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-runtime-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-jpackage-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/jpackage-input/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-jpackage-main-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>moneycraft-desktop.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>validate-checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- UM-110-03: Native Windows .msi and .exe workstation installer via Java 25 jlink + jpackage -->
        <profile>
            <id>windows-installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-windows-jlink-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jlink</executable>
                                    <arguments>
                                        <argument>--add-modules</argument>
                                        <argument>${moneycraft.desktop.jlink.modules}</argument>
                                        <argument>--strip-debug</argument>
                                        <argument>--no-man-pages</argument>
                                        <argument>--no-header-files</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.directory}/runtime-image</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>package-windows-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>msi</argument>
                                        <argument>--name</argument>
                                        <argument>MoneyCraft</argument>
                                        <argument>--app-version</argument>
                                        <argument>${moneycraft.desktop.app.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${moneycraft.desktop.vendor}</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>moneycraft-desktop.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${moneycraft.desktop.main.class}</argument>
                                        <argument>--runtime-image</argument>
                                        <argument>${project.build.directory}/runtime-image</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-menu-group</argument>
                                        <argument>MoneyCraft</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>${moneycraft.desktop.win.upgrade.uuid}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>package-windows-exe</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>exe</argument>
                                        <argument>--name</argument>
                                        <argument>MoneyCraft</argument>
                                        <argument>--app-version</argument>
                                        <argument>${moneycraft.desktop.app.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${moneycraft.desktop.vendor}</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>moneycraft-desktop.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${moneycraft.desktop.main.class}</argument>
                                        <argument>--runtime-image</argument>
                                        <argument>${project.build.directory}/runtime-image</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-menu-group</argument>
                                        <argument>MoneyCraft</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>${moneycraft.desktop.win.upgrade.uuid}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- macOS native app-image packaging profile via Java 25 jlink + jpackage -->
        <profile>
            <id>macos-installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-macos-jlink-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jlink</executable>
                                    <arguments>
                                        <argument>--add-modules</argument>
                                        <argument>${moneycraft.desktop.jlink.modules}</argument>
                                        <argument>--strip-debug</argument>
                                        <argument>--no-man-pages</argument>
                                        <argument>--no-header-files</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.directory}/runtime-image</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>package-macos-app-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>MoneyCraft</argument>
                                        <argument>--app-version</argument>
                                        <argument>${moneycraft.desktop.app.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${moneycraft.desktop.vendor}</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>moneycraft-desktop.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${moneycraft.desktop.main.class}</argument>
                                        <argument>--runtime-image</argument>
                                        <argument>${project.build.directory}/runtime-image</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dapple.laf.useScreenMenuBar=true</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
