# ==============================================================================
# MoneyCraft 1.0.0 — Shared Edge Gateway Reverse-Proxy Route Table
# Rendered into `/tmp/nginx-conf.d/gateway-routes.inc` at container startup.
# Shared by `:8443` (TLS 1.3 everywhere) and `:8080` (ONLY when `MC_DEV_ALLOW_HTTP=true`).
# ==============================================================================

# Hard-block Spring Boot Actuator endpoints from ever reaching external clients
location ^~ /actuator {
    return 404;
}

# Unbuffered Server-Sent Events (SSE) operational notification channel
location = /api/v1/events/stream {
    limit_req zone=mc_erp_limit burst=50 nodelay;
    limit_req_status 429;

    proxy_pass http://${MC_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Request-ID $mc_req_id;
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# Strict credential brute-force rate limit (10r/m, burst=5) on auth ceremonies
location ^~ /api/v1/auth/ {
    limit_req zone=mc_auth_limit burst=5 nodelay;
    limit_req_status 429;

    proxy_pass http://${MC_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Request-ID $mc_req_id;
    proxy_read_timeout 60s;
}

# High-speed keyboard ERP API traffic (120r/s, burst=200)
location ^~ /api/v1/ {
    limit_req zone=mc_erp_limit burst=200 nodelay;
    limit_req_status 429;

    proxy_pass http://${MC_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Request-ID $mc_req_id;
    proxy_set_header Idempotency-Key $http_idempotency_key;
    proxy_set_header If-Match $http_if_match;
    proxy_read_timeout 120s;
}

# Angular 22 SPA container (injects CSP nonces & serves pre-compressed assets)
location / {
    proxy_pass http://${MC_UI_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Request-ID $mc_req_id;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
}
