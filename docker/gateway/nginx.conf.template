# ==============================================================================
# MoneyCraft 1.0.0 — Edge Gateway Nginx Routing, Rate Limiting & TLS 1.3 Config
# Rendered into `/tmp/nginx-conf.d/default.conf` at container startup.
#   - `staging` & `prod` (`MC_DEV_ALLOW_HTTP=false`): `:8080` enforces HTTP `308`
#     redirect to `https://$host:${MC_HTTPS_REDIRECT_PORT}$request_uri`.
#   - `dev` (`MC_DEV_ALLOW_HTTP=true`): BOTH `:8080` (`http://localhost:18080`)
#     and `:8443` (`https://localhost:18443`) reverse-proxy SPA + API routes.
# ==============================================================================

limit_req_zone $binary_remote_addr zone=mc_auth_limit:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=mc_erp_limit:20m rate=120r/s;
limit_conn_zone $binary_remote_addr zone=mc_conn_limit:10m;

map $http_x_request_id $mc_req_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 8080;
    server_name ${MC_PUBLIC_HOSTNAME} _;

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    include /tmp/nginx-conf.d/http-port8080-mode.inc;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${MC_PUBLIC_HOSTNAME} _;

    ssl_certificate     /tmp/tls/fullchain.pem;
    ssl_certificate_key /tmp/tls/privkey.pem;
    ssl_protocols       TLSv1.3 TLSv1.2;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:McTLS:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    limit_conn mc_conn_limit 64;

    include /tmp/nginx-conf.d/gateway-routes.inc;
}
